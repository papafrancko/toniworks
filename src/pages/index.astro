---
import Base from '../layouts/Base.astro';
import FilmCard from '../components/FilmCard.astro';
import { films } from '../data/films';
import { site } from '../data/site';

const description = `Reklamefilm fra ${site.name}, et produktionsselskab i ${site.city}. Der sker ikke meget i dem. Det er meningen.`;
---

<Base description={description} activeNav="work" spacer="home">
  <h1 class="heading" lang="en">work portfolio</h1>
  {
    films.length > 0 ? (
      <div class="grid">
        {films.map((film, index) => (
          <FilmCard film={film} eager={index < 2} />
        ))}
      </div>
    ) : (
      <p class="empty">Der kommer mere. Vi optager langsomt.</p>
    )
  }
</Base>

<style>
  /* Same small caps label as 'kontakt' and 'næste film' */
  .heading {
    margin: 96px 0 0;
    padding: 0 var(--margin);
    color: var(--ink-dim);
    font-size: var(--type-micro);
    font-weight: var(--type-micro-weight);
    letter-spacing: var(--type-micro-ls);
    text-transform: uppercase;
  }

  /* The label takes over the grid's top air */
  .heading + .grid {
    margin-top: 28px;
  }

  /* An odd count simply leaves the last cell empty */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--gap-row);
    margin-top: 96px;
    padding: 0 var(--margin);
  }

  .empty {
    margin-top: 96px;
    padding: 0 var(--margin);
    color: var(--ink-dim);
    line-height: var(--type-body-lh);
    text-wrap: pretty;
  }

  @media (max-width: 767px) {
    .heading {
      margin-top: 48px;
    }

    .heading + .grid {
      margin-top: 20px;
    }

    .grid {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 48px;
    }

    .empty {
      margin-top: 48px;
    }
  }
</style>
