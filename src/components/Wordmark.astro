---
/**
 * The TONI wordmark, rebuilt as vector geometry from materiale/logo.jpg
 * (the only logo file supplied; it has no vector master). No circle here:
 * the navy badge is used for favicon and share images only.
 *
 * The viewBox is cut at cap height and baseline, so in a baseline-aligned
 * row the bottom of the mark sits on the text baseline. Size it with
 * `height` (= cap height); width follows the viewBox ratio.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class:list={['wordmark', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="15.3 58.6 119.82 38"
  role="img"
  aria-label="TONI Works"
  fill="currentColor"
>
  <g transform="matrix(1 0 -0.39 1 37.67 0)">
    <path
      fill-rule="evenodd"
      d="M5.9 58.6H36V67.6H26.05V96.6H15.55V67.6H5.9ZM47.7 58.6H60A9 9 0 0 1 69 67.6V87.6A9 9 0 0 1 60 96.6H47.7A9 9 0 0 1 38.7 87.6V67.6A9 9 0 0 1 47.7 58.6ZM49.2 67.6V87.6H58.5V67.6ZM73.5 58.6H84.5L94 77.6V58.6H104.4V96.6H93.9L83.9 76.6V96.6H73.5ZM109.6 58.6H120.1V96.6H109.6Z"
    ></path>
  </g>
</svg>

<style>
  .wordmark {
    display: inline-block;
    width: auto;
    overflow: visible;
  }
</style>
